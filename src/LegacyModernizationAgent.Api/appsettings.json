{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "Data Source=data/legacymod.db"
  },

  "Jobs": {
    "UseHangfire": true,
    "HangfireDb": "data/hangfire.db"
  },

  "Ai": {
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1",
    "ChatModel": "gpt-4o-mini",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingVectorSize": 1536
  },

  "Storage": {
    "AllowLocalPaths": true,
    "CleanupAfterAnalysis": true
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Qdrant": {
    "Url": "http://localhost:6333",
    "Collection": "code_embeddings"
  }
}
