<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b3b10243-8098-460e-a1ea-3bb208494702</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- data/ altına klonlanan/yüklenen kullanıcı repoları derleme glob'una asla dahil olmamalı -->
    <Compile Remove="data/**" />
    <Content Remove="data/**" />
    <None Remove="data/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.18" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.18">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LegacyModernizationAgent.Application\LegacyModernizationAgent.Application.csproj" />
    <ProjectReference Include="..\LegacyModernizationAgent.Infrastructure\LegacyModernizationAgent.Infrastructure.csproj" />
  </ItemGroup>

</Project>
